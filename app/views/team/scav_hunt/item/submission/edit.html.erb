<main>
  <h2>Edit Submission for Item <%= @item.number %></h2>

  <p class="item-submission-text">Item <%= @item.number %>: <%= @item.content %></p>

  <%= form_for @item.item_submission, url: team_scav_hunt_item_submission_path(@team_scav_hunt, *@item.for_url), method: :patch do |f| %>
    <%= f.label :instructions, "Item Presenter Instructions" %><br>
    <small>If your item is physical, this should include where/how to find your it and what it is. It also should include any special instructions around presenting your item if you have them.</small>
    <p>
    <%= f.textarea :instructions, required: true, cols: 80, rows: 10 %>
    </p>
    <%= f.submit %>
  <% end %>
</main>
