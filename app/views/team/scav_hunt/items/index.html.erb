<main>
  <section id="the-list">
    <% if !@skip_header %>
      <h2>The List</h2>
      <p><%= link_to "(see list by point value)", team_scav_hunt_items_points_path(@team_scav_hunt) %></p>
      <p>
        Search:
        <input type="text" id="item-search">
      </p>
      <div class="form-field">
        <div class="form-radio-bar">
         <input id="assigned-assigned" type="radio" value="assigned" name="assigned"><%#
          %><label for="assigned-assigned">Assigned</label><%#
          %><input id="assigned-unassigned" type="radio" value="false" name="assigned"><%#
          %><label for="assigned-unassigned">Unassigned</label><%#
          %><input id="assigned-submitted" type="radio" value="submitted" name="assigned"><%#
          %><label for="assigned-submitted">Done</label>
        </div>
        <div class="form-radio-bar-clear">
          <input id="assigned-none" type="radio" value="" name="assigned">
          <label for="assigned-none" class="radio-bar-clear">(clear)</label>
        </div>
      </div>
      <div style="margin-top: 0.6em;">
        <input type="checkbox" name="timed" id="timed">
        <label for="timed">Timed?</label>
        <br>
        <input type="checkbox" name="digital-submission" id="digital-submission">
        <label for="digital-submission">Digital Submission?</label>
      </div>
    <% end %>
    <% @items_by_category_by_page.each.with_index do |(category, pages), idx| %>
      <section>
        <% if category != :nil %>
          <h3><%= link_to category.name, team_scav_hunt_category_path(@team_scav_hunt, category) %></h3>
        <% end %>
        <% pages.each do |page_number, items| %>
          <section>
            <% if page_number != :nil %>
              <% if category != :nil %>
                <h4>Page <%= page_number %></h4>
              <% else %>
                <h4><%= link_to "Page #{page_number}", team_scav_hunt_page_path(@team_scav_hunt, page_number) %></h4>
              <% end %>
            <% end %>
            <%= render "list", items: items %>
          </section>
        <% end %>
      </section>
      <% if idx < @items_by_category_by_page.length - 1 %>
        <hr>
      <% end %>
    <% end %>
  </section>
</main>

<%= javascript_import_module_tag "controllers/item_search" %>
